{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["environmentId", "serviceAccountName", "api", "web"],
  "properties": {
    "environmentId": { "type": "string", "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$" },
    "serviceAccountName": { "type": "string", "minLength": 1 },
    "api": { "$ref": "#/definitions/component" },
    "web": { "$ref": "#/definitions/component" }
  },
  "definitions": {
    "component": {
      "type": "object",
      "required": ["image", "port", "healthPath", "livenessPath", "resources"],
      "properties": {
        "image": {
          "type": "object",
          "required": ["repository", "digest"],
          "properties": {
            "repository": { "type": "string", "pattern": "^ghcr\\.io/[a-z0-9_./-]+$" },
            "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          }
        },
        "port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "healthPath": { "type": "string", "pattern": "^/" },
        "livenessPath": { "type": "string", "pattern": "^/" },
        "resources": { "type": "object", "required": ["requests", "limits"] }
      }
    }
  }
}
